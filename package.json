{
  "name": "eu-tender-platform",
  "version": "1.0.0",
  "description": "EU Tender Platform - Digital tender management system",
  "private": true,
  "scripts": {
    "dev": "npx next dev",
    "build": "npx next build",
    "start": "npx next start",
    "lint": "npx next lint",
    "lint:fix": "npx next lint --fix",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "format": "npx prettier --write .",
    "clean": "rm -rf .next dist",
    "test:powercell": "node scripts/run-powercell-suite.mjs",
    "test:smoke": "node scripts/run-powercell-suite.mjs --suite smoke",
    "test:journeys": "node scripts/run-powercell-suite.mjs --suite journeys",
    "test:edges": "node scripts/run-powercell-suite.mjs --suite edges",
    "test:report": "node scripts/powercell-report.mjs",
    "test:local": "node scripts/dev-test-run.mjs",
    "udbud:functional-test": "node scripts/run-from-repo-root.mjs && node scripts/udbud-functional-test.mjs",
    "check-db": "tsx scripts/check-db.ts",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/types.ts"
  },
  "keywords": [
    "blockbid",
    "tender",
    "nextjs",
    "typescript",
    "eu-procurement",
    "public-tendering",
    "supabase"
  ],
  "author": "BlockBid",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/auth-helpers-nextjs": "^0.8.7",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.38.0",
    "@types/fs-extra": "^11.0.4",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "fs-extra": "^11.3.4",
    "lucide-react": "^1.8.0",
    "next": "^14.0.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.4.31",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "resend": "^6.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "xmlbuilder2": "^4.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "prettier": "^3.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/eu-tender-platform.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/eu-tender-platform/issues"
  },
  "homepage": "https://github.com/your-org/eu-tender-platform#readme"
}
