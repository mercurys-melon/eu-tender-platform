# ============================================================
# eu-tender-platform - miljøvariable
# Kopiér denne fil til .env og udfyld værdierne lokalt.
# .env må ALDRIG commites (tilføjes til .gitignore).
# I produktion sættes variable via host-miljøet eller Supabase Vault.
# ============================================================

# --- Applikationskontekst ---
NODE_ENV=development            # development | test | staging | production
PORT=3000
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal

# --- Udbud.dk (ERST) ---
# Auth-flow: Basic Auth → OIDC client_credentials → Bearer token (JWT, 600s gyldighed).
# Samme credentials bruges til PREPROD og PROD — adskillelse er 100% URL-baseret.
# UDBUD_DK_ENV=preprod er default (sikkerhedsforsvarslinje mod utilsigtet prod-publicering).
# Credentials fås fra ERST via https://blanket.virk.dk/... (kræver MitID Erhverv).
UDBUD_DK_ENV=preprod                           # preprod | prod — KRÆVER eksplicit prod-valg
UDBUD_DK_BASIC_USER=                           # brugernavn fra ERST (email-format)
UDBUD_DK_BASIC_PASS=                           # adgangskode fra ERST (SMS-kode ved oprettelse)
UDBUD_DK_PREPROD_API_URL=https://api-demo.udbud.dk/udbud
UDBUD_DK_PROD_API_URL=https://api.udbud.dk/udbud
UDBUD_DK_PREPROD_TOKEN_URL=https://erstpreprod.virk.dk/auth/token?grant_type=client_credentials
UDBUD_DK_PROD_TOKEN_URL=https://erst.virk.dk/auth/token?grant_type=client_credentials

# --- TED API v3 (EU Publications Office) ---
# OBS: TEDAPI v2 udfaset ultimo september 2025 - al integration skal ske mod v3.
# Nøglen genereres i TED Developer Portal efter EU Login.
TED_API_KEY=
TED_API_BASE_URL=https://preview.ted.europa.eu/api
EFORMS_SDK_VERSION=eforms-sdk-dk-1.13.0-1.3.0
# Format: eforms-sdk-dk-{sdk}.{dansk-extension} — verificer aktuelt tag mod git.erst.dk/udbud-dk/sdk
# Accepterer også: semver (1.13.2) eller dansk extension uden prefix (1.13.0-1.3.0)

# --- Supabase ---
# Region SKAL være i EU pga. data residency-krav (GDPR + offentligt indkøb).
# Regionen vælges ved projektoprettelse i Supabase og kan ikke ændres efterfølgende.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=              # publishable / klient-sikker
SUPABASE_SERVICE_KEY=           # secret - kun server-side, aldrig eksponér til klient
SUPABASE_REGION=eu-central-1    # f.eks. eu-central-1, eu-west-1, eu-north-1

# --- AI-evaluering ---
# Anthropic: Zero Data Retention (ZDR) SKAL være aktiveret og DPA SKAL være underskrevet.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7 # primær model til juridisk/struktureret analyse

# OpenAI som fallback - kun med DPA + EU residency konfigureret.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Observability ---
SENTRY_DSN=
