{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  , "types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "bin.disabled/**",
    "tests.disabled/**",
    "tests/**",
    "scripts/**",
    "server/**",
    "src/flows/**",
    "src/auth/login.ts",
    "src/utils/selectors.ts",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}

